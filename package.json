{
  "name": "fixly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @fixly/web --filter @fixly/api --filter @fixly/worker dev",
    "format": "prettier --write .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @fixly/database generate",
    "db:migrate": "pnpm --filter @fixly/database migrate",
    "db:seed": "pnpm --filter @fixly/database seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
